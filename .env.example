# No fijes NODE_ENV aquí: Vite usa production en "npm run build" y Express toma development por defecto.
PORT=4000
# Definilo en true solo para una vista previa estática sin API.
VITE_STATIC_PREVIEW=
MONGODB_URI=
MONGODB_DATABASE=carnivoras_tucuman
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Cuenta de administración de /admin.html y firma de sesiones de cliente (en Netlify se guardan como variables de entorno)
ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_NAME=Administrador
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
USER_SESSION_SECRET=
# Asistente botánico, recomendador y copiloto admin con Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=120
