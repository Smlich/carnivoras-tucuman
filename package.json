{
  "name": "carnivoras-tucuman",
  "version": "0.1.0",
  "description": "Tienda MERN de plantas carnívoras para Carnívoras Tucumán.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/src/index.js",
    "dev:all": "concurrently -k -n web,api -c green,blue \"vite --host 127.0.0.1\" \"node --watch server/src/index.js\"",
    "start": "node server/src/index.js",
    "start:server": "node server/src/index.js",
    "test": "node --test \"server/test/**/*.test.js\" && tsx --test \"src/games/dionaea-strike/game/*.test.ts\"",
    "lint:game": "tsc --noEmit -p tsconfig.game.json",
    "test:integration:mongo": "node --test server/test/integration/mongodb-products.integration.js",
    "seed:products": "node server/src/scripts/seed-products.js",
    "seed:admin": "node server/src/scripts/seed-admin.js",
    "images:optimize": "node scripts/optimize-catalog-images.mjs",
    "images:optimize:gallery": "node scripts/optimize-gallery-images.mjs",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.28",
    "@netlify/blobs": "^11.1.11",
    "better-auth": "^1.7.28",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.81.0",
    "mongodb": "^7.9.1",
    "mongoose": "^9.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
